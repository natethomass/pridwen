# Build parameters, read by the Justfile and by CI.

# Output image name. Matches the GitHub repo name.
IMAGE_NAME=pridwen

# GitHub user or organisation that owns the repo and the ghcr.io package.
REPO_ORGANIZATION="natethomass"

IMAGE_DESC="Pridwen OS: an immutable, hardened Fedora Atomic desktop that teaches sysadmin and security skills while you daily-drive it"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,gnome,learning,security,sysadmin"
IMAGE_LOGO_URL="https://github.com/natethomass.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
