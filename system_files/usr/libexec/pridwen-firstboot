  background-color: rgba(255,255,255,0.06); color: #ECE6DA; border-radius: 99px;
  border: 1px solid rgba(255,255,255,0.12); padding: 4px 10px;
}
.pridwen-card searchentry:focus-within { border-color: #8FB0CC; }
.pridwen-card scrolledwindow.pick {
  border-radius: 18px; border: 1px solid rgba(255,255,255,0.10);
  background-color: rgba(255,255,255,0.05);
}
.pridwen-card list.pick { background: transparent; }
.pridwen-card list.pick row { padding: 10px 16px; color: #ECE6DA; border-radius: 12px; margin: 2px 6px; }
.pridwen-card list.pick row:selected { background-color: rgba(143,176,204,0.22); color: #F2EDE3; }
.pridwen-card list.pick row .dim { color: #7E776C; }
""" % NIGHT_WALLPAPER.encode()

USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
RESERVED = {"root", "gdm", "gnome-initial-setup", "pridwen", "admin", "administrator"}


def log(msg):
    print(f"pridwen-firstboot: {msg}", file=sys.stderr, flush=True)


def dconf_write(path, gvariant_text):
    r = subprocess.run(["dconf", "write", path, gvariant_text], capture_output=True, text=True)
    log(f"dconf write {path} {gvariant_text} -> rc={r.returncode} {r.stderr.strip()}")


def gsettings_set(schema, key, value):
    r = subprocess.run(["gsettings", "set", schema, key, value], capture_output=True, text=True)
    log(f"gsettings set {schema} {key} {value} -> rc={r.returncode} {r.stderr.strip()}")


def suggest_username(fullname):
    base = re.sub(r"[^a-z0-9]", "", fullname.split(" ")[0].lower()) if fullname.strip() else ""
    return base[:32]


class Page(Gtk.Box):
    """One wizard step: a glass card with a title, lede, body, and its own validity."""

    def __init__(self, wizard, title, lede, primary="Continue"):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER)
        self.wizard = wizard
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, width_request=560)
        card.add_css_class("glass")
        card.add_css_class("pridwen-card")
        t = Gtk.Label(label=title, xalign=0, wrap=True)
        t.add_css_class("pridwen-title")
        l = Gtk.Label(label=lede, xalign=0, wrap=True)
        l.add_css_class("pridwen-lede")
        card.append(t)
        card.append(l)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.append(self.body)

        footer = Gtk.Box(spacing=8, margin_top=10)
        self.back = Gtk.Button(label="Back")
        self.back.add_css_class("pridwen-ghost")
        self.back.connect("clicked", lambda *_: wizard.go(-1))
        footer.append(self.back)
        footer.append(Gtk.Box(hexpand=True))
        self.next = Gtk.Button(label=primary)
        self.next.add_css_class("pridwen-primary")
        self.next.connect("clicked", self.on_next)
        footer.append(self.next)
        card.append(footer)
        self.append(card)

    def on_next(self, *_):
        self.wizard.go(+1)

    def validate(self):
        self.next.set_sensitive(True)

    def shown(self):
        self.validate()


class WelcomePage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "Welcome to Pridwen", "A Linux that teaches you to run it. A few choices and the desktop is yours.")
        self.back.set_visible(False)
        img = Gtk.Image.new_from_file(MARK)
        img.set_pixel_size(96)
        img.set_halign(Gtk.Align.START)
        self.body.append(img)
        note = Gtk.Label(xalign=0, wrap=True, label="Your disk is encrypted, the firewall is closed, and the system runs from a read-only image that updates atomically. Every one of those is a lesson later.")
        note.add_css_class("pridwen-muted")
        self.body.append(note)


class AccountPage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "Create your account", "This is the administrator. sudo works, and every Coach hint is addressed to you.")
        group = Adw.PreferencesGroup()
        self.fullname = Adw.EntryRow(title="Full name")
        self.username = Adw.EntryRow(title="Username")
        self.password = Adw.PasswordEntryRow(title="Password")
        self.confirm = Adw.PasswordEntryRow(title="Confirm password")
        for r in (self.fullname, self.username, self.password, self.confirm):
            group.add(r)
            r.connect("changed", lambda *_: self.validate())
        self.body.append(group)
        self.hint = Gtk.Label(xalign=0, wrap=True, label="")
        self.hint.add_css_class("pridwen-muted")
        self.body.append(self.hint)
        self._auto_username = True
        self.fullname.connect("changed", self.on_fullname)
        self.username.connect("changed", self.on_username_edit)

    def on_fullname(self, *_):
        if self._auto_username:
            self.username.handler_block_by_func(self.on_username_edit)
            self.username.set_text(suggest_username(self.fullname.get_text()))
            self.username.handler_unblock_by_func(self.on_username_edit)

    def on_username_edit(self, *_):
        self._auto_username = self.username.get_text() == ""

    def validate(self):
        name = self.fullname.get_text().strip()
        user = self.username.get_text()
        pw, cf = self.password.get_text(), self.confirm.get_text()
        problems = []
        if not name:
            problems.append("Enter your name.")
        if not USERNAME_RE.match(user):
            problems.append("Username: lowercase letters, digits, _ or -, starting with a letter.")
        elif user in RESERVED:
            problems.append("That username is reserved.")
        else:
            try:
                pwd.getpwnam(user)
                problems.append("That username already exists.")
            except KeyError:
                pass
        if len(pw) < 8:
            problems.append("Password: at least 8 characters. Longer beats clever.")
        elif pw != cf:
            problems.append("Passwords do not match.")
        self.hint.set_text(problems[0] if problems else "Looks good.")
        self.next.set_sensitive(not problems)

    def shown(self):
        self.validate()
        self.fullname.grab_focus()


class ChoicePage(Page):
    """A single-choice page backed by a dconf key."""

    def __init__(self, wizard, title, lede, key, choices, default):
        super().__init__(wizard, title, lede)
        self.key = key
        self.value = default
        group = Adw.PreferencesGroup()
        first = None
        for value, label, subtitle in choices:
            row = Adw.ActionRow(title=label, subtitle=subtitle, activatable=True)
            check = Gtk.CheckButton(valign=Gtk.Align.CENTER)
            if first is None:
                first = check
            else:
                check.set_group(first)
            check.set_active(value == default)
            check.connect("toggled", self.on_toggle, value)
            row.add_prefix(check)
            row.set_activatable_widget(check)
            group.add(row)
        self.body.append(group)

    def on_toggle(self, check, value):
        if check.get_active():
            self.value = value


class PickList(Gtk.Box):
    """A searchable single-choice list: items are (id, label, hint)."""

    def __init__(self, items, default, on_change=None, height=270):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.value = default
        self.on_change = on_change
        self.search = Gtk.SearchEntry(placeholder_text="Search")
        self.search.connect("search-changed", lambda *_: self.list.invalidate_filter())
        self.append(self.search)
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.list.add_css_class("pick")
        self.list.set_filter_func(self.filter_row)
        default_row = None
        for pid, label, hint in items:
            row = Gtk.ListBoxRow()
            row.pid, row.text = pid, f"{label} {hint}".lower()
            box = Gtk.Box(spacing=8)
            box.append(Gtk.Label(label=label, xalign=0, hexpand=True, ellipsize=3))
            if hint:
                h = Gtk.Label(label=hint, xalign=1)
                h.add_css_class("dim")
                box.append(h)
            row.set_child(box)
            self.list.append(row)
            if pid == default:
                default_row = row
        self.list.connect("row-selected", self.on_selected)
        scroller = Gtk.ScrolledWindow(child=self.list, min_content_height=height, max_content_height=height,
                                      hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.add_css_class("pick")
        self.append(scroller)
        if default_row is not None:
            self.list.select_row(default_row)
            GLib.idle_add(lambda: (default_row.grab_focus(), False)[1])

    def filter_row(self, row):
        q = self.search.get_text().strip().lower()
        return not q or all(w in row.text for w in q.split())

    def on_selected(self, _list, row):
        if row is not None and row.pid != self.value:
            self.value = row.pid
            if self.on_change:
                self.on_change(self.value)


def all_locales():
    """(locale, language name, country) for every installed locale, English (US) first."""
    if GnomeDesktop is None:
        return []
    out = []
    for loc in GnomeDesktop.get_all_locales():
        name = GnomeDesktop.get_language_from_locale(loc, None) or loc
        out.append((loc, name, ""))
    out.sort(key=lambda t: (t[0] != "en_US.UTF-8", t[1].lower()))
    return out


def all_layouts():
    """(xkb id, display name, short name) for every keyboard layout, US first."""
    if GnomeDesktop is None:
        return []
    info = GnomeDesktop.XkbInfo()
    out = []
    for lid in info.get_all_layouts():
        ok, display, short, _layout, _variant = info.get_layout_info(lid)
        if ok:
            out.append((lid, display or lid, short or ""))
    out.sort(key=lambda t: (t[0] != "us", t[1].lower()))
    return out


def all_timezones():
    """(zone, zone with spaces, country codes) from zone1970.tab, US Central first."""
    out = []
    try:
        with open("/usr/share/zoneinfo/zone1970.tab", encoding="utf-8") as f:
            for line in f:
                if not line.strip() or line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) < 3:
                    continue
                zone = parts[2]
                out.append((zone, zone.replace("_", " "), parts[0]))
    except OSError:
        return []
    out.sort(key=lambda t: (t[0] != "America/Chicago", t[1].lower()))
    return out


class TimezonePage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "Where are you?", "Sets the clock. With location services on, GNOME keeps it right when you travel.")
        self.pick = PickList(all_timezones(), "America/Chicago")
        self.body.append(self.pick)

    @property
    def value(self):
        return self.pick.value


class LanguagePage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "Language", "For menus, dates, and the Coach. Pridwen's lessons are in English for now.")
        self.pick = PickList(all_locales(), "en_US.UTF-8")
        self.body.append(self.pick)

    @property
    def value(self):
        return self.pick.value


class KeyboardPage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "Keyboard", "Pick your layout before you type a password. It applies right away, so try it in the search box.")
        self.pick = PickList(all_layouts(), "us", on_change=self.apply_live)
        self.body.append(self.pick)

    @property
    def value(self):
        return self.pick.value

    def apply_live(self, layout_id):
        # This session's Shell follows input-sources immediately.
        gsettings_set("org.gnome.desktop.input-sources", "sources", f"[('xkb', '{layout_id}')]")


class GuidePage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "The Guide", "An assistant that explains what you're looking at and never runs anything for you.")
        note = Gtk.Label(xalign=0, wrap=True, label="Connect it later from the Academy: paste an API key for a cloud model, or pick a local model to stay fully offline. Nothing is sent anywhere until you do.")
        note.add_css_class("pridwen-muted")
        self.body.append(note)


class PrivacyPage(Page):
    def __init__(self, wizard):
        super().__init__(wizard, "Your learning stays here", "Progress, journal, and command history live in a local database on this computer. No account, no telemetry.", primary="Enter Pridwen")
        self.status = Gtk.Label(xalign=0, wrap=True, label="")
        self.status.add_css_class("pridwen-muted")
        self.body.append(self.status)
        self.fallback = Gtk.Button(label="Go to the login screen", visible=False)
        self.fallback.add_css_class("pridwen-ghost")
        self.fallback.connect("clicked", lambda *_: self.wizard.quit_to_greeter("user chose login screen"))
        self.body.append(self.fallback)

    def set_status(self, text, warn=False):
        self.status.set_text(text)
        self.status.remove_css_class("pridwen-warn" if not warn else "pridwen-muted")
        self.status.add_css_class("pridwen-warn" if warn else "pridwen-muted")

    def on_next(self, *_):
        self.next.set_sensitive(False)
        self.back.set_sensitive(False)
        self.set_status("Creating your account…")
        self.wizard.finish(self)


class Wizard(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.pages = []
        self.index = 0
        self.client = None
        self.greeter = None
        self.verifier = None
        self.password = None
        self.page = None
        self.handoff_started = None
        self.session_opened = False

    # ---- lifecycle ---------------------------------------------------------
    def do_startup(self):
        Adw.Application.do_startup(self)
        log(f"starting as uid={os.getuid()} home={GLib.get_home_dir()}")
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.connect_gdm()

    def do_activate(self):
        win = Adw.ApplicationWindow(application=self, title="Welcome to Pridwen")
        win.add_css_class("pridwen")
        win.set_deletable(False)
        win.connect("close-request", lambda *_: True)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT, transition_duration=380, hexpand=True, vexpand=True)
        self.account = AccountPage(self)
        self.track = ChoicePage(self, "Where are you starting from?", "This sets which lessons the Coach offers first. Change it any time in the Academy.",
                                "/org/pridwen/learner/track",
                                [("beginner", "Never used a terminal", "Start with the shell, files, and permissions."),
                                 ("helpdesk", "I work help desk", "Skip the basics, go straight to users, services, and troubleshooting."),
                                 ("cert", "I'm studying for a cert", "RHCSA first, Linux+ and Security+ alongside.")],
                                "beginner")
        self.look = ChoicePage(self, "Day or night?", "Cream by day, glass by night. Follow the sun and it changes itself.",
                               "/org/pridwen/look/mode",
                               [("auto", "Follow the sun", "Switches at sunrise and sunset."),
                                ("day", "Always day", "The cream canvas."),
                                ("night", "Always night", "Deep night, where the glass shows.")],
                               "auto")
        self.language = LanguagePage(self) if GnomeDesktop else None
        self.keyboard = KeyboardPage(self) if GnomeDesktop else None
        self.timezone = TimezonePage(self) if all_timezones() else None
        self.pages = [p for p in [WelcomePage(self), self.language, self.keyboard, self.timezone, self.account, self.track,
                                  self.look, GuidePage(self), PrivacyPage(self)] if p is not None]
        for i, p in enumerate(self.pages):
            self.stack.add_named(p, f"p{i}")
        overlay = Gtk.Overlay(child=self.stack)
        self.dots = Gtk.Label(halign=Gtk.Align.CENTER, valign=Gtk.Align.END, margin_bottom=28)
        self.dots.add_css_class("pridwen-dots")
        overlay.add_overlay(self.dots)
        win.set_content(overlay)
        win.fullscreen()
        win.present()
        self.show(0)

    def show(self, i):
        self.index = max(0, min(i, len(self.pages) - 1))
        self.stack.set_visible_child_name(f"p{self.index}")
        self.pages[self.index].shown()
        self.dots.set_markup("  ".join('<span foreground="#ECE6DA">●</span>' if k == self.index else "○" for k in range(len(self.pages))))

    def go(self, delta):
        self.show(self.index + delta)

    def quit_to_greeter(self, why):
        """End this session. gnome-initial-setup.service's ExecStopPost shuts the
        session down and GDM shows the greeter, where the new user is listed."""
        log(f"quitting to greeter: {why}")
        self.quit()

    # ---- GDM hand-off --------------------------------------------------------
    def connect_gdm(self):
        try:
            self.client = Gdm.Client()
            self.greeter = self.client.get_greeter_sync(None)
            self.verifier = self.client.get_user_verifier_sync(None)
        except Exception as e:  # noqa: BLE001
            log(f"no GDM greeter connection ({e}); will fall back to the login screen after setup")
            self.greeter = self.verifier = None
            return
        log("connected to GDM greeter and user verifier")
        v = self.verifier
        v.connect("info", lambda _v, s, m, *r: log(f"pam info [{s}]: {m}"))
        v.connect("problem", lambda _v, s, m, *r: log(f"pam problem [{s}]: {m}"))
        v.connect("info-query", lambda _v, s, q, *r: log(f"pam info-query [{s}]: {q} (unanswered)"))
        v.connect("secret-info-query", self.on_secret_query)
        v.connect("verification-complete", lambda _v, s, *r: log(f"verification complete [{s}]"))
        v.connect("verification-failed", self.on_verification_failed)
        v.connect("conversation-stopped", lambda _v, s, *r: log(f"conversation stopped [{s}]"))
        v.connect("service-unavailable", lambda _v, s, *r: log(f"service unavailable [{s}]: {r}"))
        self.greeter.connect("session-opened", self.on_session_opened)

    def on_secret_query(self, verifier, service, question, *_rest):
        log(f"pam secret-info-query [{service}]: {question}")
        if self.password is not None:
            verifier.call_answer_query(service, self.password, None, None, None)
            self.password = None
            log("answered secret query")
        else:
            log("no password left to send")

    def on_verification_failed(self, _v, service, *_rest):
        log(f"verification failed [{service}]")
        self.handoff_failed("GDM could not verify the new account.")

    def on_session_opened(self, greeter, service, *_rest):
        # GdmGreeter::session-opened carries (service_name, session_id).
        log(f"session opened [{service}]; asking GDM to start it")
        self.session_opened = True
        try:
            greeter.call_start_session_when_ready_sync(service, True, None)
            log("start_session_when_ready sent")
            if self.page:
                self.page.set_status("Opening your desktop…")
        except GLib.Error as e:
            log(f"start_session_when_ready failed: {e.message}")
            self.handoff_failed("GDM did not start the session.")

    def handoff_failed(self, why):
        if self.page is None:
            return
        self.page.set_status(f"{why} Your account is ready; sign in from the login screen.", warn=True)
        self.page.fallback.set_visible(True)
        win = self.get_active_window()
        if win:
            win.set_visible(True)

    def handoff_watchdog(self):
        if self.session_opened:
            return False
        log(f"no session after {HANDOFF_TIMEOUT_S}s")
        self.handoff_failed("The desktop did not start in time.")
        return False

    # ---- finish --------------------------------------------------------------
    def finish(self, page):
        self.page = page
        username = self.account.username.get_text()
        fullname = self.account.fullname.get_text().strip()
        self.password = self.account.password.get_text()
        mgr = AccountsService.UserManager.get_default()
        log(f"creating user {username!r} ({fullname!r}); manager loaded={mgr.props.is_loaded}")

        def create(*_):
            if not mgr.props.is_loaded:
                return
            mgr.disconnect_by_func(create) if _ else None
            mgr.create_user_async(username, fullname, AccountsService.UserAccountType.ADMINISTRATOR, None, self.on_created, None)

        if mgr.props.is_loaded:
            create()
        else:
            mgr.connect("notify::is-loaded", create)

    def on_created(self, mgr, res, _data):
        try:
            user = mgr.create_user_finish(res)
        except GLib.Error as e:
            log(f"create_user failed: {e.message}")
            self.page.set_status(f"Could not create the account: {e.message}", warn=True)
            self.page.next.set_sensitive(True)
            self.page.back.set_sensitive(True)
            return
        log(f"user created uid={user.get_uid()} name={user.get_user_name()}")
        user.set_password(self.password, "")
        user.set_password_mode(AccountsService.UserPasswordMode.REGULAR)
        log("password set")
        uid = user.get_uid()

        # Language and keyboard: on the account (GDM applies the language at
        # login), in this session's dconf (copied over), and system-wide via
        # localed, which the initial-setup polkit rules allow. All best effort.
        if self.language is not None:
            loc = self.language.value
            user.set_language(loc)
            r = subprocess.run(["localectl", "set-locale", f"LANG={loc}"], capture_output=True, text=True)
            log(f"language {loc}: set on account; localectl rc={r.returncode} {r.stderr.strip()}")
        if self.timezone is not None:
            tz = self.timezone.value
            r = subprocess.run(["timedatectl", "set-timezone", tz], capture_output=True, text=True)
            log(f"timezone {tz}: timedatectl rc={r.returncode} {r.stderr.strip()}")
        if self.keyboard is not None:
            lid = self.keyboard.value
            gsettings_set("org.gnome.desktop.input-sources", "sources", f"[('xkb', '{lid}')]")
            layout, _, variant = lid.partition("+")
            r = subprocess.run(["localectl", "set-x11-keymap", layout, "", variant], capture_output=True, text=True)
            log(f"keyboard {lid}: localectl rc={r.returncode} {r.stderr.strip()}")

        # Choices, into this session's dconf: the copy worker carries them over.
        dconf_write(self.track.key, f"'{self.track.value}'")
        dconf_write(self.look.key, f"'{self.look.value}'")
        scheme = {"day": "default", "night": "prefer-dark"}.get(self.look.value, "default")
        gsettings_set("org.gnome.desktop.interface", "color-scheme", scheme)

        home = GLib.get_home_dir()
        try:
            os.makedirs(os.path.join(home, ".config"), exist_ok=True)
            with open(os.path.join(home, ".config", "gnome-initial-setup-done"), "w") as f:
                f.write("yes\n")
            with open(os.path.join(home, "gnome-initial-setup-uid"), "w") as f:
                f.write(f"{uid}")
            log("wrote gnome-initial-setup-done and gnome-initial-setup-uid")
        except OSError as e:
            log(f"could not write hand-off files in {home}: {e}")

        self.page.set_status("Account ready. Opening your desktop…")
        GLib.timeout_add(600, self.log_in, user.get_user_name())

    def log_in(self, username):
        if self.verifier is None or self.greeter is None:
            log("no GDM connection; going to the login screen")
            self.page.set_status("Account created. Taking you to the login screen…")
            GLib.timeout_add(1500, lambda: (self.quit_to_greeter("no gdm connection"), False)[1])
            return False
        self.handoff_started = time.monotonic()
        try:
            self.verifier.call_begin_verification_for_user_sync(SERVICE_NAME, username, None)
            log(f"begin_verification_for_user({SERVICE_NAME}, {username}) sent")
        except GLib.Error as e:
            log(f"begin_verification_for_user failed: {e.message}")
            self.handoff_failed("GDM refused to start verification.")
            return False
        GLib.timeout_add_seconds(HANDOFF_TIMEOUT_S, self.handoff_watchdog)
        return False


if __name__ == "__main__":
    sys.exit(Wizard().run(sys.argv))
