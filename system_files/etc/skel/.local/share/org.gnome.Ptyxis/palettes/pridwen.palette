# Pridwen Cream Glass terminal palette. Day = cream canvas with ink text,
# night = deep night with cream text. Reds lean clay, greens sage, blues slate,
# so the terminal reads as part of the desktop. Installed from /etc/skel; Ptyxis
# only scans ~/.local/share/org.gnome.Ptyxis/palettes and its own resources.
[Palette]
Name=Pridwen

[Light]
Foreground=#24211D
Background=#F2EDE3
Cursor=#24211D
Color0=#24211D
Color1=#A9503A
Color2=#4F8060
Color3=#9A7A30
Color4=#46678A
Color5=#7E5C86
Color6=#3F7C82
Color7=#D8D2C6
Color8=#6B665D
Color9=#B9714E
Color10=#6E9E7A
Color11=#B7963F
Color12=#5F7E9B
Color13=#A57FA8
Color14=#5A9AA0
Color15=#FBF8F2
TitlebarForeground=#24211D
TitlebarBackground=#E7DFD1
BellForeground=#24211D
BellBackground=#C9A45C
SuperuserForeground=#F2EDE3
SuperuserBackground=#B9714E
RemoteForeground=#F2EDE3
RemoteBackground=#5F7E9B

[Dark]
Foreground=#ECE6DA
Background=#111318
Cursor=#F2EDE3
Color0=#1A1D24
Color1=#C4675A
Color2=#6E9E7A
Color3=#C9A45C
Color4=#5F7E9B
Color5=#A57FA8
Color6=#6FA3A8
Color7=#D8D2C6
Color8=#4A4F5A
Color9=#D98577
Color10=#8CB897
Color11=#DEBE7A
Color12=#8FB0CC
Color13=#C0A0C4
Color14=#8FC2C6
Color15=#F2EDE3
TitlebarForeground=#ECE6DA
TitlebarBackground=#15181E
BellForeground=#111318
BellBackground=#C9A45C
SuperuserForeground=#F2EDE3
SuperuserBackground=#B9714E
RemoteForeground=#111318
RemoteBackground=#8FB0CC
